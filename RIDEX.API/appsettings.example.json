{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=ridex_dev.db",
    "PostgreSQL": "Host=localhost;Port=5432;Database=ridex_db;Username=postgres;Password=your_password"
  },
  "Jwt": {
    "Secret": "YOUR_SUPER_SECURE_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG_HERE",
    "Issuer": "RIDEX.API",
    "Audience": "RIDEX.Mobile",
    "ExpiryMinutes": 1440
  },
  "RideXConfig": {
    "UseLocalDatabase": true,
    "UseMockWeather": false,
    "UseMockRouting": false,
    "EnableOfflineMode": true
  }
}
