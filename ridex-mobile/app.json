{
  "expo": {
    "name": "RIDEX",
    "slug": "ridex",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ridex",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#080808"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ridex.app"
    },
    "android": {
      "package": "com.ridex.app",
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    }
  }
}
