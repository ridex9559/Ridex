# RIDEX Platform — Environment Variables Example
# 100% Free Operating Cost Configuration

# Database: Leave empty to run in zero-configuration SQLite mode
DATABASE_CONNECTION_STRING=
# Or specify PostgreSQL connection:
# DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=ridex_db;Username=postgres;Password=your_password

# Authentication
JWT_SECRET=RIDEX_ULTRA_SECURE_ZERO_COST_DEVELOPMENT_SECRET_KEY_1234567890!@#$%
JWT_ISSUER=RIDEX.API
JWT_AUDIENCE=RIDEX.Mobile

# External Providers (All optional / zero-cost defaults)
# Open-Meteo Weather: No API key required
# OpenStreetMap Routing (OSRM): No API key required
# Nominatim Geocoding: No API key required
