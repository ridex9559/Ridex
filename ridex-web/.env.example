# RIDEX Web Application — Environment Variables Template
# Public browser-safe variables only. Never commit private service secrets.

# Supabase Project Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional .NET API & SignalR endpoints
VITE_API_URL=http://localhost:5000/api/v1
VITE_SIGNALR_URL=http://localhost:5000/hubs/rides

# Map Theme Default: carto_dark | osm_standard | opentopo
VITE_DEFAULT_MAP_THEME=carto_dark
